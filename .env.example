# Environment variables for the Idempotent Payment Gateway
# Copy this file to .env and fill in your values

# ──────────────── DATABASE ────────────────
DB_HOST=localhost
DB_PORT=5432
DB_USER=pguser
DB_PASSWORD=pgpassword
DB_NAME=payment_gateway

# Test database (separate instance via docker-compose)
DB_TEST_HOST=localhost
DB_TEST_PORT=5433
DB_TEST_NAME=payment_gateway_test

# ──────────────── API ────────────────
NODE_ENV=development
PORT=3001
API_VERSION=v1

# ──────────────── CORS ────────────────
# Comma-separated list of allowed origins
CORS_ORIGINS=http://localhost:5173

# ──────────────── IDEMPOTENCY ────────────────
# How long idempotency keys are retained (hours)
IDEMPOTENCY_TTL_HOURS=24

# Maximum length of a client-provided idempotency key
IDEMPOTENCY_KEY_MAX_LENGTH=255

# ──────────────── PAYMENT PROCESSING ────────────────
# Processing timeout — payments stuck in PROCESSING longer
# than this (seconds) are eligible for recovery
PROCESSING_TIMEOUT_SECONDS=300

# ──────────────── RATE LIMITING ────────────────
# Requests per minute per IP
RATE_LIMIT_MAX=100
RATE_LIMIT_WINDOW_MS=60000

# ──────────────── LOGGING ────────────────
LOG_LEVEL=info
